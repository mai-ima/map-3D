{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "allowJs": false,
    "declaration": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ijm/shared": ["packages/shared/src/index.ts"],
      "@ijm/shared/*": ["packages/shared/src/*"],
      "@ijm/gis": ["packages/gis/src/index.ts"],
      "@ijm/gis/*": ["packages/gis/src/*"],
      "@ijm/routing": ["packages/routing/src/index.ts"],
      "@ijm/routing/*": ["packages/routing/src/*"],
      "@ijm/navigation": ["packages/navigation/src/index.ts"],
      "@ijm/navigation/*": ["packages/navigation/src/*"],
      "@ijm/map-engine": ["packages/map-engine/src/index.ts"],
      "@ijm/map-engine/*": ["packages/map-engine/src/*"],
      "@ijm/ai": ["packages/ai/src/index.ts"],
      "@ijm/ai/*": ["packages/ai/src/*"],
      "@ijm/ui": ["packages/ui/src/index.ts"],
      "@ijm/ui/*": ["packages/ui/src/*"]
    }
  }
}
