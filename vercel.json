{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace @ijm/web",
  "outputDirectory": "apps/web/.next",
  "regions": ["hnd1"],
  "functions": {
    "apps/web/app/api/ai/chat/route.ts": { "maxDuration": 60 },
    "apps/web/app/api/route/route.ts": { "maxDuration": 30 },
    "apps/web/app/api/poi/route.ts": { "maxDuration": 45 },
    "apps/web/app/api/furniture/route.ts": { "maxDuration": 45 }
  },
  "headers": [
    {
      "source": "/cesium/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
