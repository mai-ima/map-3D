# Immersive Japan Map — 環境変数のひな形
#
#   cp .env.example .env.local     （Next.js は .env.local を読み込む）
#
# .env / .env.local は絶対に Git にコミットしないこと（.gitignore 済み）。
# NEXT_PUBLIC_ が付いた変数だけがブラウザに露出する。API キーには絶対に付けない。

# ---------------------------------------------------------------- ルーティング
# valhalla（既定） または osrm
ROUTING_ENGINE=valhalla

# 自前 Valhalla を使う場合（Docker Compose では http://valhalla:8002）
# 未設定の場合は FOSSGIS の公開デモサーバを使う。
# 公開デモは 1 リクエスト/秒の制限があり、本番利用には向かない。
# VALHALLA_URL=http://localhost:8002

# 公開デモサーバ利用時に付与するクライアント識別子（利用ポリシーで推奨されている）
VALHALLA_CLIENT_ID=immersive-japan-map

# OSRM をフォールバックとして使う場合（プロファイルごとに別 URL）
#
# 車線案内（どの車線に寄るか）は、いまのところ OSRM の応答からだけ読める。
# OSRM は OSM の turn:lanes を解釈して intersections[].lanes として返す。
# Valhalla の車線情報は応答の形を実データで確認できていないため未対応
# （推測で解釈すると、実在しない矢印で車線を寄らせることになる）。
# 車線案内を使いたい場合は ROUTING_ENGINE=osrm にする。
# OSRM_DRIVE_URL=http://localhost:5000/route/v1/driving
# OSRM_WALK_URL=http://localhost:5001/route/v1/walking
# OSRM_BIKE_URL=http://localhost:5002/route/v1/cycling

ROUTING_TIMEOUT_MS=20000

# ------------------------------------------------------------------ OSM 関連
# Overpass API（カンマ区切りで複数指定するとフェイルオーバする）
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter

# Nominatim（公開インスタンスは 1req/s・User-Agent 必須）
NOMINATIM_URL=https://nominatim.openstreetmap.org

# 公開インスタンスを使う場合、連絡先を含む識別可能な User-Agent が必須
OSM_USER_AGENT=immersive-japan-map/0.1 (+https://github.com/mai-ima/map-3d)

GIS_TIMEOUT_MS=20000

# -------------------------------------------------------------- PLATEAU / 地形
# 自前ホストの 3D Tiles を使う場合に上書きする
# PLATEAU_TILESET_BASE=http://localhost:8090
# PLATEAU_TERRAIN_URL=https://tile.plateauview.mlit.go.jp/terrain

# ------------------------------------------------------------------------ AI
# openai / anthropic / gemini / local のいずれか。未設定なら AI 機能は無効。
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5

# GEMINI_API_KEY=
# AI_MODEL=gemini-2.0-flash

# ローカル LLM（Ollama / llama.cpp / vLLM など OpenAI 互換エンドポイント）
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
# LOCAL_LLM_API_KEY=

AI_TIMEOUT_MS=60000

# ------------------------------------------------------------------ データベース
# セルフホスト構成でのみ使用（Vercel デモでは不要）
# DATABASE_URL=postgres://ijm:ijm@localhost:5432/ijm

# ------------------------------------------------------------------ Cesium ion
# 未設定でも全機能が動作する（地図=地理院タイル、地形=PLATEAU-Terrain）。
# ion の World Imagery などを使いたい場合のみ設定する。
# NEXT_PUBLIC_CESIUM_ION_TOKEN=
